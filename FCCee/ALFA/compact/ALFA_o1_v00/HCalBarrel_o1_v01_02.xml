<lccdd>
    <!--  Definition of global dictionary constants          -->
    <define>
        <!-- Two-section layout: front layers with thinner absorber, back layers with thicker absorber.
             Common (non-absorber) part of each layer: 3 (scint) + 1.5 (PCB) + 1.5 (FEE) + 5 (Cu) + 2 (steel) = 13 mm -->
        <constant name="HCalBarrel_front_layers" value="(int) 25"/>
        <constant name="HCalBarrel_back_layers" value="(int) 13"/>
        <constant name="HCalBarrel_front_absorber_thickness" value="30*mm"/>
        <constant name="HCalBarrel_back_absorber_thickness" value="50*mm"/>
        <constant name="HCalBarrel_layer_common_thickness" value="13*mm"/>
        <constant name="HCalBarrel_front_layer_thickness" value="HCalBarrel_front_absorber_thickness+HCalBarrel_layer_common_thickness"/>
        <constant name="HCalBarrel_back_layer_thickness" value="HCalBarrel_back_absorber_thickness+HCalBarrel_layer_common_thickness"/>
        <constant name="HCalBarrel_layers" value="HCalBarrel_front_layers+HCalBarrel_back_layers"/>
        <constant name="HCalBarrel_total_thickness" value="HCalBarrel_front_layers*HCalBarrel_front_layer_thickness+HCalBarrel_back_layers*HCalBarrel_back_layer_thickness"/>
        <constant name="HCal_cell_size" value="3.0*cm"/>

    </define>

    <!--  Definition of the used visualization attributes    -->
    <display>
        <vis name="HCalBarrelVis"    alpha="1" r="0.0"  g="0.3"  b="0.8" showDaughters="true" visible="true"/>
        <vis name="HCalStavesVis"    alpha="1" r="0.0"  g="0.0"  b="0.1" showDaughters="true" visible="false"/>
        <vis name="HCalLayerVis"     alpha="1" r="1.0"  g="0.5" b="0.75" showDaughters="false" visible="true"/>
        <vis name="HCalSensorVis"    alpha="1" r="1.0"  g="0.0"  b="0.2" showDaughters="true" visible="true"/>
        <vis name="HCalAbsorberVis"  alpha="1" r="0.4"  g="0.4"  b="0.6" showDaughters="true" visible="true"/>

        <vis name="HCalEndcapVis"          alpha="1" r="1"    g="1"    b="0.1" showDaughters="false" visible="true"/>
        <vis name="HCalEndcapLayerVis"     alpha="1" r="1"    g="0.5"  b="1.0" showDaughters="false" visible="true"/>
    </display>

    <!--  Definition of the readout segmentation/definition  -->
    <readouts>
        <readout name="HCalBarrelCollection">
          <segmentation type="CartesianGridXY" grid_size_x="HCal_cell_size" grid_size_y="HCal_cell_size" />
          <id>system:5,side:2,module:8,stave:4,layer:9,submodule:4,x:32:-16,y:-16</id>
        </readout>
    </readouts>

    <detectors>
        <detector id="DetID_HCAL_Barrel" name="HCalBarrel" type="GenericCalBarrel_o1_v01" readout="HCalBarrelCollection" vis="HCALVis" calorimeterType="HAD_BARREL" gap="0.*cm" material="Steel235">

            <comment>Hadron Calorimeter Barrel</comment>

	    <type_flags type=" DetType_CALORIMETER + DetType_HADRONIC + DetType_BARREL"/>

            <envelope vis="HCALVis">
                <shape type="PolyhedraRegular" numsides="HCalBarrel_symmetry"  rmin="HCalBarrel_inner_radius-10*env_safety" rmax="HCalBarrel_inner_radius+HCalBarrel_total_thickness+10*env_safety" dz="HCalBarrel_half_length*2+10*env_safety" material = "Air"/>
                <rotation x="0*deg" y="0*deg" z="90*deg-180*deg/HCalBarrel_symmetry"/>
            </envelope>


            <dimensions numsides="HCalBarrel_symmetry" rmin="HCalBarrel_inner_radius" z="HCalBarrel_half_length*2"/>
            <staves vis="HCalStavesVis"/>
            <!-- Front section -->
            <layer repeat="(int) HCalBarrel_front_layers" vis="HCalLayerVis">
                <slice material="Steel235" thickness="HCalBarrel_front_absorber_thickness" vis="HCalAbsorberVis" radiator="yes"/>
                <slice material="G4_POLYSTYRENE" thickness="3*mm" sensitive="yes" limits="cal_limits" vis="HCalSensorVis"/>
                <slice material="PCB" thickness="1.5*mm" vis="HCalPCBVis"/>
                <slice material="FEEMat" thickness="1.5*mm" vis="HCalCopperVis"/>
                <slice material="Copper" thickness="5*mm" vis="HCalCopperVis"/>
                <slice material="Steel235" thickness="2*mm" vis="HCalAbsorberVis" radiator="yes"/>
            </layer>
            <!-- Back section -->
            <layer repeat="(int) HCalBarrel_back_layers" vis="HCalLayerVis">
                <slice material="Steel235" thickness="HCalBarrel_back_absorber_thickness" vis="HCalAbsorberVis" radiator="yes"/>
                <slice material="G4_POLYSTYRENE" thickness="3*mm" sensitive="yes" limits="cal_limits" vis="HCalSensorVis"/>
                <slice material="PCB" thickness="1.5*mm" vis="HCalPCBVis"/>
                <slice material="FEEMat" thickness="1.5*mm" vis="HCalCopperVis"/>
                <slice material="Copper" thickness="5*mm" vis="HCalCopperVis"/>
                <slice material="Steel235" thickness="2*mm" vis="HCalAbsorberVis" radiator="yes"/>
            </layer>
        </detector>

    </detectors>

</lccdd>

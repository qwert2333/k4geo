<lccdd>
  <!-- Grainita ECAL endcaps (development version).
       Each endcap (+z and -z) is: front carbon plate / sector layer (crystal modules + back space) / back carbon plate.
       The crystal layer is divided into nsides sectors in phi, each divided into ntheta modules in theta
       (barrel-like construction, with tilt). A module is a carbon frame with the crystal inside.
       All geometry parameters are attributes of the <detector> element, read by the driver; the values
       may refer to global constants (e.g. DectDimensions). Only add <define> constants for values that a
       readout segmentation needs, since segmentation parameters cannot refer to detector attributes.

       Conventions:
         - All radii follow the TGeoPgon convention: distance from the z axis to the flat face.
         - "front" is the face closer to the IP, "back" the face further away.
         - zmin is the |z| of the front face of the front plate.
         - Sector depth along z = crystal thickness + back space (as the barrel). The front rmin is at the
           sector front face (crystal front), the back rmin at the sector back face (next to the back plate).
         - Outer boundary: IP-pointing cone theta_out = atan(front rmax / zmin), i.e. front rmax is the outer
           radius at zmin; the outer radii of the plates and of the sector faces follow from it (not tilted).
         - Theta range: from min(atan(rmin_front/z_front), atan(rmin_back/z_back)) to theta_out,
           with z_front / z_back the |z| of the sector front / back faces; divided equally into ntheta.
         - Inner boundary follows the given radii (not forced to point to the IP).
         - Tilt (same angle and construction as the barrel, not tilted if <tilt> is absent):
             phi:   inner sector vertices on the regular polygon at min(rmin), outer vertices rotated by +angle
                    at the corner radius of max(rmax); side walls are planes parallel to z, shared by neighbours.
             theta: internal theta walls go from the IP ray theta_i at the sector front face to the IP ray
                    (theta_i - angle) at the sector back face, i.e. tilted towards larger |cos(theta)|.
           With angle = 0 the side walls are radial and the internal theta walls point to the IP.
         - Module length along z: innermost module (inner face parallel to z): the crystal thickness;
           other modules: every ray from the IP crossing the module has a crystal path >= crystal thickness
           (as the barrel), i.e. h = thickness * cos(smallest IP angle inside the module).
  -->

  <detectors>
    <detector name="Grainita_ECAL_Endcaps_v02" type="Grainita_ECAL_Endcaps_v02" vis="CaloVis" id="DetID_ECAL_Endcap">
      <type_flags type="DetType_CALORIMETER + DetType_ELECTROMAGNETIC + DetType_ENDCAP"/>

      <!-- nsides: number of phi sectors, ntheta: number of theta modules per sector -->
      <dimensions zmin="ECalEndcaps_half_length" nphi="72" ntheta="6"/>

      <!-- Tilt angle in phi and theta. Uses the barrel constant so that barrel and endcap sectors stay
           aligned in phi (requires the barrel compact file to be included before this file). -->
      <tilt angle="EcalBarrel_ModuleTiltAngle"/>

      <!-- Crystal layer: thickness along z; inner radii at the sector front and back faces;
           front rmax = outer radius at zmin, defining the IP-pointing outer cone -->
      <crystal material="MixGrains" thickness="40.5*cm" vis="SensitiveVis">
        <front rmin="ECalEndcaps_front_inner_radius" rmax="ECalEndcaps_front_outer_radius"/>
        <back  rmin="ECalEndcaps_back_inner_radius"/>
      </crystal>

      <!-- Space behind the modules inside the sector (as the barrel BackSpace) -->
      <backspace thickness="1.8*cm"/>

      <!-- Carbon fiber module walls: thickness measured normal to each of the four side faces
           (front/back faces of the module have no wall) -->
      <wall material="CarbonFiber" thickness="2.5*mm" vis="CarbonFrameVis"/>

      <!-- Carbon fiber plates on the front and back faces (PolyhedraRegular, inner radius of the adjacent sector face, outer radius on the outer cone at the plate face closer to the IP) -->
      <plate material="CarbonFiber" thickness="10*mm" vis="CarbonFrameVis"/>
    </detector>
  </detectors>

</lccdd>

<lccdd>

  <comment> Global dimensions and detector identifiers for ALFA_o1_v00 </comment>
  <define>

    <constant name="DetID_ARCBARREL" value="8"/>
    <constant name="DetID_ARCENDCAP" value="9"/>
    <constant name="DetID_ECAL_Barrel" value="10"/>
    <constant name="DetID_ECAL_Endcap" value="11"/>
    <constant name="DetID_HCAL_Barrel" value="12"/>
    <constant name="DetID_HCAL_Endcap" value="13"/>

    <constant name="env_safety" value="0.1*mm"/>

    <constant name="tracker_region_zmax"   value="2.1*m"/>
    <constant name="tracker_region_rmax"      value="1.8*m"/>

    <constant name="DetID_OTBar_Barrel"   value="67"/>
    <constant name="OTBar_inner_radius"   value="500*mm"/>
    <constant name="OTBar_outer_radius"   value="1800*mm"/>
    <constant name="OTBar_nGroupingModules" value="1"/>

    <!--
        WARNING:
          The following variables named as ARC_* are fixed by design.
          If changed, reoptimization of sensor/mirror geometry is needed
    -->
    <constant name="ArcEndcap_inner_radius"     value=" 28 * cm"    />
    <constant name="ArcEndcap_outer_radius"     value="190 * cm"    />
    <constant name="ArcEndcap_total_length"      value=" 20 * cm"    />
    <constant name="ArcBarrel_inner_radius"     value="190 * cm"    />
    <constant name="ArcBarrel_outer_radius"     value="210 * cm"    />
    <constant name="ArcBarrel_total_length"      value="440 * cm"    />
    <!-- ArcEndcap_position_z is the middle of the endcap
          the endcap spans over ArcEndcap_position_z +- ArcEndcap_total_length/2  -->
    <constant name="ArcEndcap_position_z"        value="210*cm"    />

    <constant name="ECalBarrel_inner_radius" value="2200*mm"/>
    <constant name="ECalBarrel_half_length" value="2300*mm"/>

    <constant name="Solenoid_inner_radius" value="2700*mm"/>
    <constant name="Solenoid_outer_radius" value="3000*mm"/>
    <constant name="Solenoid_half_length" value="2920*mm"/>
    <constant name="Solenoid_Coil_radius" value="2825*mm"/>
    <constant name="Solenoid_Coil_half_length" value="2850*mm"/>

    <constant name="HCalBarrel_inner_radius" value="3020*mm"/>
    <constant name="HCalBarrel_outer_radius" value="4920*mm"/>
    <constant name="HCalBarrel_half_length" value="2920*mm"/>
    <constant name="HCalBarrel_symmetry" value="12"/>

    <constant name="HCalEndcap_inner_radius" value="340*mm"/>
    <constant name="HCalEndcap_outer_radius" value="HCalBarrel_outer_radius"/>
    <constant name="HCalEndcap_min_z" value="HCalBarrel_half_length+100*mm"/>
    <constant name="HCalEndcap_max_z" value="HCalBarrel_half_length+100*mm+2680*mm"/>
    <constant name="HCalEndcap_symmetry" value="12"/>
    <constant name="HCalEndcap_zcutout" value="200*mm"/>
    <constant name="HCalEndcap_rcutout" value="0*mm"/>
  </define>

</lccdd>

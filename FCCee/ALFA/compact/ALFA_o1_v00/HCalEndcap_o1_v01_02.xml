<lccdd>
    <define>
        <!-- Two-section layout (same as HCalBarrel_o1_v01_02): front layers with thinner absorber,
             back layers with thicker absorber.
             Common (non-absorber) part of each layer: 3 (scint) + 1.5 (PCB) + 1.5 (FEE) + 5 (Cu) + 2 (steel) = 13 mm -->
        <constant name="HCalEndcap_front_layers" value="(int) 25"/>
        <constant name="HCalEndcap_back_layers" value="(int) 13"/>
        <constant name="HCalEndcap_front_absorber_thickness" value="30*mm"/>
        <constant name="HCalEndcap_back_absorber_thickness" value="50*mm"/>
        <constant name="HCalEndcap_layer_common_thickness" value="13*mm"/>
        <constant name="HCalEndcap_front_layer_thickness" value="HCalEndcap_front_absorber_thickness+HCalEndcap_layer_common_thickness"/>
        <constant name="HCalEndcap_back_layer_thickness" value="HCalEndcap_back_absorber_thickness+HCalEndcap_layer_common_thickness"/>
        <constant name="HCalEndcap_layers" value="HCalEndcap_front_layers+HCalEndcap_back_layers"/>
        <constant name="HCal_cell_size" value="3.0*cm"/>
        <!-- Cutout layers are taken from the front section (requires HCalEndcap_cutout_layers <= HCalEndcap_front_layers) -->
        <constant name="HCalEndcap_cutout_layers" value="- floor( -HCalEndcap_zcutout / HCalEndcap_front_layer_thickness)"/>
    </define>


    <detectors>
        <detector name="HCalEndcaps" type="DD4hep_SubdetectorAssembly" vis="HCALVis">

                <shape type="BooleanShape" operation="Subtraction" material="Air">
                    <shape type="BooleanShape" operation="Subtraction">
                        <shape type="BooleanShape" operation="Subtraction">
                            <shape type="PolyhedraRegular"  numsides="HCalEndcap_symmetry" rmin="0" rmax="HCalEndcap_outer_radius+5*env_safety" dz="2.0*HCalEndcap_max_z+10*env_safety"/>
                            <shape type="PolyhedraRegular"  numsides="HCalEndcap_symmetry" rmin="0" rmax="HCalEndcap_outer_radius+10*env_safety" dz="2.0*HCalEndcap_min_z-5*env_safety"/>
                        </shape>
                        <shape type="PolyhedraRegular"  numsides="HCalEndcap_symmetry" rmin="0" rmax="HCalEndcap_inner_radius + HCalEndcap_rcutout" dz="2.0*HCalEndcap_min_z + 2*HCalEndcap_zcutout"/>
                    </shape>
                    <shape type="Tube" rmin="0" rmax="HCalEndcap_inner_radius-env_safety" dz="2.0*HCalEndcap_max_z + 2*HCalEndcap_zcutout"/>
                </shape>
                <rotation x="0*deg" y="0*deg" z="90*deg-180*deg/HCalEndcap_symmetry"/>


            <comment>HCalEndcap Assembly</comment>
            <composite name="HCalEndcap"/>
        </detector>
    </detectors>




    <!--  Definition of the readout segmentation/definition  -->
    <readouts>
        <readout name="HCalEndcapCollection">
            <segmentation type="CartesianGridXY" grid_size_x="HCal_cell_size" grid_size_y="HCal_cell_size" />
            <id>system:5,side:2,module:8,stave:4,layer:9,submodule:4,x:32:-16,y:-16</id>
        </readout>
    </readouts>


    <detectors>

        <detector name="HCalEndcap" type="GenericCalEndcap_o1_v01" id="DetID_HCAL_Endcap" readout="HCalEndcapCollection" vis="HCALVis" >

            <comment>Hadronic Calorimeter Endcap</comment>

	    <type_flags type=" DetType_CALORIMETER + DetType_HADRONIC + DetType_ENDCAP"/>

            <envelope vis="HCALVis">
                <shape type="Assembly"/>
            </envelope>


            <dimensions nsides_inner="HCalEndcap_symmetry" nsides_outer="(int) HCalEndcap_symmetry" zmin="HCalEndcap_min_z" rmin="HCalEndcap_inner_radius" rmax="HCalEndcap_outer_radius" phi0="0" rmin2="HCalEndcap_rcutout" z2="HCalEndcap_cutout_layers * HCalEndcap_front_layer_thickness"/>

            <!-- Front section: cutout layers -->
            <layer repeat="HCalEndcap_cutout_layers" gap="HCalEndcap_rcutout" vis="HCalEndcapLayerVis">
                <slice material="Steel235" thickness="HCalEndcap_front_absorber_thickness" vis="HCalAbsorberVis" radiator="yes"/>
                <slice material="G4_POLYSTYRENE" thickness="3*mm" sensitive="yes" limits="cal_limits" vis="HCalSensorVis"/>
                <slice material="PCB" thickness="1.5*mm" vis="HCalPCBVis"/>
                <slice material="FEEMat" thickness="1.5*mm" vis="HCalCopperVis"/>
                <slice material="Copper" thickness="5*mm" vis="HCalCopperVis"/>
                <slice material="Steel235" thickness="2*mm" vis="HCalAbsorberVis" radiator="yes"/>
            </layer>

            <!-- Front section: remaining layers -->
            <layer repeat="HCalEndcap_front_layers - HCalEndcap_cutout_layers" vis="HCalEndcapLayerVis">
                <slice material="Steel235" thickness="HCalEndcap_front_absorber_thickness" vis="HCalAbsorberVis" radiator="yes"/>
                <slice material="G4_POLYSTYRENE" thickness="3*mm" sensitive="yes" limits="cal_limits" vis="HCalSensorVis"/>
                <slice material="PCB" thickness="1.5*mm" vis="HCalPCBVis"/>
                <slice material="FEEMat" thickness="1.5*mm" vis="HCalCopperVis"/>
                <slice material="Copper" thickness="5*mm" vis="HCalCopperVis"/>
                <slice material="Steel235" thickness="2*mm" vis="HCalAbsorberVis" radiator="yes"/>
            </layer>

            <!-- Back section -->
            <layer repeat="HCalEndcap_back_layers" vis="HCalEndcapLayerVis">
                <slice material="Steel235" thickness="HCalEndcap_back_absorber_thickness" vis="HCalAbsorberVis" radiator="yes"/>
                <slice material="G4_POLYSTYRENE" thickness="3*mm" sensitive="yes" limits="cal_limits" vis="HCalSensorVis"/>
                <slice material="PCB" thickness="1.5*mm" vis="HCalPCBVis"/>
                <slice material="FEEMat" thickness="1.5*mm" vis="HCalCopperVis"/>
                <slice material="Copper" thickness="5*mm" vis="HCalCopperVis"/>
                <slice material="Steel235" thickness="2*mm" vis="HCalAbsorberVis" radiator="yes"/>
            </layer>


        </detector>

    </detectors>










</lccdd>

<lccdd>

  <info name="ALFA_o1_v00"
    title="Master file for the ALFA detector concept"
    author="Various, Tracker by E.Ploerer, Grainita ECAL and HCAL by F.Guo"
    url="no"
    status="development"
    version="o1_v00">
    <comment>
      Based on IDEA master file.
      Contains the Grainita ECAL, solenoid, and tile HCAL.
    </comment>
  </info>

  <comment> World dimensions </comment>
  <define>
    <constant name="world_side" value="20.0*m"/>
    <constant name="world_x" value="world_side / 2.0"/>
    <constant name="world_y" value="world_side / 2.0"/>
    <constant name="world_z" value="world_side / 2.0"/>
  </define>

  <comment> Global detector dimensions </comment>
  <include ref="DetDimension_ALFA_o1_v00.xml" />

  <include ref="${DD4hepINSTALL}/DDDetectors/compact/detector_types.xml" />

  <comment> Material definitions </comment>
  <includes>
    <gdmlFile  ref="elements.xml"/>
    <gdmlFile  ref="materials.xml"/>
  </includes>

  <comment> Magnetic field strength </comment>
  <define>
    <constant name="Solenoid_field" value="3.0*tesla"/>
  </define>

  <limits>
      <limitset name="cal_limits">
          <limit name="step_length_max" particles="*" value="1.0" unit="mm" />
      </limitset>
  </limits>

  <comment> Sub-detector definitions </comment>

  <comment> Grainita ECAL </comment>
  <include ref="Grainita_ECAL_Barrel_v02.xml" />

  <comment> Barrel solenoid </comment>
  <include ref="Solenoid_o1_v01_02.xml" />

  <comment> Tile HCAL from CLD_o2_v08 </comment>
  <include ref="HCalBarrel_o1_v01_01.xml" /> 
  <include ref="HCalEndcap_o1_v01_01.xml" />

  <comment> Magnetic field definition </comment>
  <comment> Assume constant field for lt inner field and lt outer field (beyond coil) </comment>
  <fields>
    <field name="Solenoid" type="solenoid"
      inner_field="Solenoid_field"
      outer_field="-1.0*tesla"
      zmax="Solenoid_Coil_half_length"
      outer_radius="Solenoid_Coil_radius">
    </field>
  </fields>






</lccdd>
